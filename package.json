{
  "name": "@wilversings/claude-sessions-cli",
  "version": "2.5.0",
  "description": "TUI session manager for Claude Code (fork of @kud/claude-sessions-cli)",
  "homepage": "https://github.com/wilversings/claude-sessions-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/wilversings/claude-sessions-cli.git"
  },
  "author": "Marius Aiordăchioaei",
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-sessions": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "7.1.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "tsup": "^8.5.1",
    "tsx": "4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
